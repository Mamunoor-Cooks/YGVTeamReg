<!-- ===== YGV ODI 1.0 · TABBYCAT THEME (paste everything below into the Team registration message / Welcome message field) ===== -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Bungee&family=Rajdhani:wght@500;600;700&display=swap');
:root{--cream:#f3e3a0;--maroon:#3d0f26;--ember:#e8531c;--glow:#ff8a2b;--ash:#1a0d08;--ash2:#2a140c}

/* ===== page ===== */
html,body{height:auto!important;min-height:0!important;margin-bottom:0!important;padding-bottom:0!important}
body{font-family:'Rajdhani',sans-serif!important;font-size:1.1rem;color:var(--cream)!important;
  background:
   radial-gradient(ellipse at 50% 105%,rgba(255,110,30,.5),transparent 55%),
   radial-gradient(ellipse at 88% 8%,rgba(190,50,20,.35),transparent 45%),
   radial-gradient(ellipse at 8% 25%,rgba(120,30,15,.4),transparent 50%),
   linear-gradient(180deg,#2b150d,#1a0d08)!important;background-attachment:fixed!important}
a{color:var(--glow)}a:hover{color:var(--cream)}
h1,h2,h3,h4,h5,h6,.h1,.h2,.h3,.h4{font-family:'Bungee',sans-serif!important;color:var(--cream)!important;letter-spacing:.03em;text-shadow:2px 2px 0 var(--maroon)}
.text-muted,small,.form-text,.help-block,.helptext{color:#d9c58a!important}
hr{border-color:rgba(243,227,160,.25)}

/* ===== navbar & footer ===== */
.navbar,.navbar.bg-primary,.navbar-dark,.navbar-light,#tabbycat-navbar{background:var(--maroon)!important;border-bottom:3px solid var(--ember);box-shadow:0 4px 24px rgba(255,90,20,.35)}
.navbar a,.navbar .nav-link,.navbar-brand,.navbar .dropdown-toggle{color:var(--cream)!important;font-family:'Bungee',sans-serif;font-size:.85rem;letter-spacing:.04em}
.navbar .nav-link:hover,.navbar .active>.nav-link{color:var(--glow)!important;text-shadow:0 0 12px var(--ember)}
.dropdown-menu{background:var(--ash2)!important;border:2px solid var(--maroon)!important;border-radius:14px}
.dropdown-item{color:var(--cream)!important}.dropdown-item:hover{background:var(--maroon)!important}
footer,.footer,#footer{background:var(--maroon)!important;color:var(--cream)!important;border-top:3px solid var(--ember)}
footer a{color:var(--glow)!important}
/* remove empty gap at the bottom of the page */
footer,.footer,#footer{margin-top:1.5rem!important;margin-bottom:0!important;padding-top:1rem!important;padding-bottom:1rem!important;min-height:0!important;height:auto!important}
footer:empty,.footer:empty{display:none!important}
main,#content,.container,.container-fluid,.wrapper,#wrapper{margin-bottom:0!important}
.container>*:last-child,.container-fluid>*:last-child,form>*:last-child{margin-bottom:0!important}
.card:last-child,.card-body>*:last-child{margin-bottom:0!important}
.card-body{padding-bottom:1.25rem}

/* ===== cards / alerts / modals ===== */
.card,.list-group-item,.modal-content,.jumbotron,.alert,.well{background:rgba(42,20,12,.88)!important;color:var(--cream)!important;
  border:2px solid var(--maroon)!important;border-radius:18px!important;box-shadow:0 0 0 1px rgba(232,83,28,.35),0 12px 30px rgba(0,0,0,.45)}
.card-header,.modal-header{background:var(--maroon)!important;color:var(--cream)!important;font-family:'Bungee',sans-serif;border-radius:16px 16px 0 0!important;border-bottom:2px solid var(--ember)!important}
.alert-danger,.alert-warning{border-color:var(--ember)!important}
.close{color:var(--cream)!important;text-shadow:none}

/* ===== REGISTRATION FORM ===== */
form label,.col-form-label,.control-label{font-family:'Bungee',sans-serif;font-size:.75rem;letter-spacing:.05em;color:var(--cream)!important}
.asteriskField{color:var(--glow)!important}
input.form-control,select.form-control,textarea.form-control,.custom-select,input[type=text],input[type=email],input[type=number],input[type=url],input[type=password],select,textarea{
  background:#25110a!important;color:var(--cream)!important;border:2px solid var(--maroon)!important;border-radius:12px!important;font-weight:600}
.form-control::placeholder{color:#a48d62!important}
.form-control:focus,.custom-select:focus,select:focus,textarea:focus{border-color:var(--ember)!important;box-shadow:0 0 0 .22rem rgba(232,83,28,.38)!important}
.form-control:disabled,.form-control[readonly]{background:#1b0b06!important;opacity:.7}
.form-check-input,input[type=checkbox],input[type=radio]{accent-color:var(--ember)}
.is-invalid,.has-error .form-control{border-color:#ff5a3c!important}
.invalid-feedback,.text-danger{color:#ff9b7a!important}
.select2-container--bootstrap4 .select2-selection,.select2-selection{background:#25110a!important;border:2px solid var(--maroon)!important;color:var(--cream)!important;border-radius:12px!important}
.select2-dropdown{background:var(--ash2)!important;color:var(--cream)!important;border:2px solid var(--maroon)!important}

/* ===== buttons: cream pill, maroon outline, ember ring ===== */
.btn,.btn-primary,.btn-success,.btn-info,.btn-secondary,.btn-outline-primary,input[type=submit]{
  background:var(--cream)!important;color:var(--maroon)!important;border:3px solid var(--maroon)!important;border-radius:999px!important;
  font-family:'Bungee',sans-serif!important;letter-spacing:.04em;padding:.6rem 1.6rem;box-shadow:0 0 0 2px var(--ember),0 6px 18px rgba(0,0,0,.4);transition:.2s}
.btn:hover,input[type=submit]:hover{background:var(--ember)!important;color:var(--cream)!important;transform:translateY(-2px);box-shadow:0 0 24px var(--glow)}
.btn-danger{background:#7a1d12!important;color:var(--cream)!important}

/* ===== tables ===== */
.table{color:var(--cream)!important;background:rgba(26,13,8,.7)}
.table thead th{background:var(--maroon)!important;color:var(--cream)!important;border-color:var(--ember)!important;font-family:'Bungee',sans-serif;font-size:.78rem}
.table td,.table th{border-color:rgba(243,227,160,.15)!important}
.table-striped tbody tr:nth-of-type(odd){background:rgba(232,83,28,.08)!important}
.table-hover tbody tr:hover{background:rgba(232,83,28,.22)!important}

/* ===== ODI banner (inside message field) ===== */
.odi-banner{position:relative;overflow:hidden;text-align:center;padding:38px 16px 30px;margin:0 0 24px;border-radius:24px;
  background:radial-gradient(ellipse at 50% 125%,rgba(255,120,30,.6),transparent 60%),rgba(26,13,8,.6);
  border:2px solid var(--maroon);box-shadow:inset 0 0 80px rgba(0,0,0,.6),0 0 40px rgba(232,83,28,.35)}
.odi-banner:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.8;background-size:260px 260px;animation:odirise 7s linear infinite;
  background-image:radial-gradient(2px 2px at 20% 80%,#ffb347,transparent),radial-gradient(2px 2px at 60% 90%,#ff8a2b,transparent),radial-gradient(3px 3px at 80% 70%,#ffd27a,transparent),radial-gradient(2px 2px at 40% 95%,#ff6a1a,transparent)}
@keyframes odirise{to{background-position:0 -260px}}
.odi-banner>*{position:relative}
.odi-pres{font-family:'Bungee',sans-serif;font-size:clamp(1rem,3vw,1.7rem);text-shadow:2px 2px 0 var(--maroon)}
.odi-title{font-family:'Bungee',sans-serif;font-size:clamp(3.2rem,12vw,8rem);line-height:1;margin:4px 0 10px;color:var(--cream);
  -webkit-text-stroke:5px var(--maroon);paint-order:stroke fill;text-shadow:0 0 30px rgba(255,110,30,.65),0 8px 0 var(--maroon)}
.odi-slogan{font-size:clamp(1.1rem,2.6vw,1.6rem);font-weight:700;max-width:720px;margin:0 auto 4px}
.odi-slogan b{color:var(--glow)}
.odi-org{font-size:.95rem;color:#d9c58a;letter-spacing:.08em;margin-bottom:18px}
.odi-meta{display:flex;flex-wrap:wrap;justify-content:center;gap:18px;margin-bottom:20px}
.odi-chip{display:inline-flex;align-items:center;gap:10px;font-family:'Bungee',sans-serif;font-size:clamp(.85rem,2.2vw,1.2rem);color:var(--cream)!important;text-decoration:none!important;text-shadow:2px 2px 0 var(--maroon)}
.odi-chip i{display:grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--maroon);font-style:normal;box-shadow:0 0 0 2px var(--ember)}
a.odi-chip:hover{color:var(--glow)!important}
.odi-discord{display:inline-block;background:var(--cream);color:var(--maroon)!important;text-decoration:none!important;font-family:'Bungee',sans-serif;
  border:3px solid var(--maroon);border-radius:999px;padding:12px 28px;box-shadow:0 0 0 2px var(--ember),0 8px 20px rgba(0,0,0,.45);transition:.2s}
.odi-discord:hover{background:var(--ember);color:var(--cream)!important;transform:translateY(-3px);box-shadow:0 0 26px var(--glow)}
.odi-hint{margin:10px 0 0!important;font-size:.95rem;color:#d9c58a}
.odi-banner{padding-bottom:22px!important;margin-bottom:18px!important}
.odi-banner p:last-child{margin-bottom:0!important}
@media(prefers-reduced-motion:reduce){.odi-banner:before{animation:none}}
</style>

<div class="odi-banner">
  <div class="odi-pres">YGV presents</div>
  <div class="odi-title">ODI 1.0</div>
  <p class="odi-slogan">ODI 1.0 — Where Arguments Matter and <b>Voices Make a Difference!</b></p>
  <p class="odi-org">ORGANIZED BY YOUNG GENERATION VOICES (YGV)</p>
  <div class="odi-meta">
    <span class="odi-chip"><i>📅</i> 20–21 November 2026</span>
    <a class="odi-chip" href="https://discord.gg/BC9kTBxJ4"><i>💬</i> Discord</a>
  </div>
  <a class="odi-discord" href="https://discord.gg/BC9kTBxJ4" target="_blank" rel="noopener">Join the Debaters’ Discord</a>
  <p class="odi-hint">Join the server before registering. All updates and draws happen there.</p>
</div>
<!-- ===== end of snippet ===== -->
